# Telegram token is only required when running the Telegram bot.
TELEGRAM_BOT_TOKEN=

# Optional: restrict bot commands/signals to one or more Telegram user ids.
# Example: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# Optional: use an explicit proxy only for Telegram Bot API requests.
# Example: socks5://127.0.0.1:1080 or http://127.0.0.1:8080
TELEGRAM_PROXY_URL=

# Optional: Telegram polling health check and reconnect timings.
TELEGRAM_CONNECTION_POOL_SIZE=32
TELEGRAM_GET_UPDATES_POOL_SIZE=8
TELEGRAM_CONCURRENT_UPDATES=8
TELEGRAM_POOL_TIMEOUT_SECONDS=30
TELEGRAM_WATCHDOG_INTERVAL_SECONDS=45
TELEGRAM_WATCHDOG_FAILURES=3
TELEGRAM_RECONNECT_BACKOFF_SECONDS=5,15,30,60,120

# Public market-data screener does not need trading API keys.
CONFIG_FILE=config.yaml
SQLITE_PATH=data/screener.sqlite3
LOG_LEVEL=INFO

# Optional: used by Coinalyze fallback and the diagnostic compare-coinalyze CLI command.
COINALYZE_API_KEY=
